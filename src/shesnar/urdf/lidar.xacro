<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <gazebo reference="laser_frame">
            <sensor name="laser" type="gpu_lidar">
                <pose> 0 0 0 0 0 0 </pose>
                <visualize>true</visualize>
                <update_rate>10</update_rate>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <min_angle>-3.14</min_angle>
                            <max_angle>3.14</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.3</min>
                        <max>12</max>
                    </range>
                </lidar>
                <topic>scan</topic>
                <gz_frame_id>laser_frame</gz_frame_id>
            </sensor>
        </gazebo>

    <joint name="laser_joint" type="fixed">
        <parent link="body"/>
        <child link="laser_frame"/>
        <origin xyz="0 0 0.338" rpy="0 0 -1.57"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.04" length="0.04"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.04" length="0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.04">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>



    <!-- ARUCO - МАРКЕРЫ -->
    <!-- высота верхнего маркера относительно звена лидара // P.S.: до этого было 0.0935 -->
    <xacro:property name="top_marker_height" value="0.102" />
    <!-- масштабирование верхнего маркера -->
    <!-- оригинальный размер маркера в модели - 0.2 м (с белыми краями); реальный на роботе - 0.07 м (без учёта белого края), 0.0933 м (с учётом) -->
    <!-- (0.07 / 6 * 8) / 0.2 = 0.466666667 -->
    <xacro:property name="top_marker_scale" value="0.466666667" />

    <!--отступ в горизонтальной плоскости (вперёд/назад/вбок)-->
    <xacro:property name="side_marker_horizontal_offset" value="0.048" />  
    <!-- отступ вниз по высоте относительно плоскости верхнего марекра // P.S.: до этого было -0.0415-->
    <xacro:property name="side_marker_vertical_offset" value="-0.07" />
    <!-- масштабирование боковых маркеров -->
    <!-- оригинальный размер маркеров в модели - 0.2 м (с белыми краями); реальные на роботе - 0.06 м (без учёта белого края), 0.08 м (с учётом) -->
    <!-- (0.06 / 6 * 8) / 0.2 = 0.4 -->
    <xacro:property name="side_marker_scale" value="0.4" />

    <link name="top_aruco">
        <visual>
            <geometry>
                 <mesh filename="file://$(find shesnar)/meshes/aruco_plane-7.obj" scale="${top_marker_scale} 0.005 ${top_marker_scale}"/> 
            </geometry>
        </visual>
    </link>

    <joint name="aruco_joint" type="fixed">
        <parent link="laser_frame"/>
        <child link="top_aruco"/>
        <origin xyz="0 0 ${top_marker_height}" rpy="1.571 0 1.571"/>
    </joint>

    <link name="right_aruco">
        <visual>
            <geometry>
                 <mesh filename="file://$(find shesnar)/meshes/aruco_plane-77.obj" scale="${side_marker_scale} 0.005 ${side_marker_scale}"/>
            </geometry>
        </visual>
    </link>

    <joint name="right_aruco_joint" type="fixed">
        <parent link="top_aruco"/>
        <child link="right_aruco"/>
        <origin xyz="0 ${side_marker_vertical_offset} ${side_marker_horizontal_offset}" rpy="1.571 0 0"/>
    </joint>

    <link name="left_aruco">
        <visual>
            <geometry>
                 <mesh filename="file://$(find shesnar)/meshes/aruco_plane-78.obj" scale="${side_marker_scale} 0.005 ${side_marker_scale}"/>
            </geometry>
        </visual>
    </link>

    <joint name="left_aruco_joint" type="fixed">
        <parent link="top_aruco"/>
        <child link="left_aruco"/>
        <origin xyz="0 ${side_marker_vertical_offset} ${-side_marker_horizontal_offset}" rpy="-1.571 0 -3.14"/>
    </joint>

    <link name="back_aruco">
        <visual>
            <geometry>
                 <mesh filename="file://$(find shesnar)/meshes/aruco_plane-83.obj" scale="${side_marker_scale} 0.005 ${side_marker_scale}"/>
            </geometry>
        </visual>
    </link>

    <joint name="back_aruco_joint" type="fixed">
        <parent link="top_aruco"/>
        <child link="back_aruco"/>
        <origin xyz="${-side_marker_horizontal_offset} ${side_marker_vertical_offset} 0" rpy="0 -1.571 1.571"/>
    </joint>

    <link name="forward_aruco">
        <visual>
            <geometry>
                 <mesh filename="file://$(find shesnar)/meshes/aruco_plane-88.obj" scale="${side_marker_scale} 0.005 ${side_marker_scale}"/>
            </geometry>
        </visual>
    </link>

    <joint name="forward_aruco_joint" type="fixed">
        <parent link="top_aruco"/>
        <child link="forward_aruco"/>
        <origin xyz="${side_marker_horizontal_offset} ${side_marker_vertical_offset} 0" rpy="0 1.571 -1.571"/>
    </joint>

    
</robot>